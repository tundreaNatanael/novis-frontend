# Base URL of the Novis API (no trailing slash). The backend's CORS_ALLOWED_ORIGINS must include this
# app's origin (http://localhost:5173 in development).
VITE_API_BASE_URL=http://localhost:8080

# `true` shows "Upload a file" on the teacher workspace's Attach material sheet. Leave it unset until
# the backend has a storage provider (STORAGE_PROVIDER=r2); a 501 from the API hides uploads anyway.
# The bucket must allow PUT from this app's origin (CORS), since the browser sends the bytes itself.
# VITE_ENABLE_UPLOADS=true
